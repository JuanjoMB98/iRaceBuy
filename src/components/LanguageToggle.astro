---
const { lang } = Astro.props;
const currentPath = Astro.url.pathname.replace(/^\/(en|es)/, "");
---

<div class="lang-toggle">
    <a
        href={`/es${currentPath}`}
        class={`icon light${lang === "es" ? " -active" : ""}`}
    >
        ES
    </a>
    <a
        href={`/en${currentPath}`}
        class={`icon dark${lang === "en" ? " -active" : ""}`}
    >
        EN
    </a>
</div>

<style>
    .lang-toggle {
        display: flex;
        border: 0;
        border-radius: 999rem;
        background-color: #0756aa56;
        cursor: pointer;
    }

    .icon {
        z-index: 1;
        position: relative;
        display: flex;
        padding: 0.5rem 12px;
        font-size: 12px;
        color: #fff;
        border-radius: 100px;
    }
    .icon.-active {
        color: #fff;
        box-shadow: 0 0px 15px rgb(0, 0, 0); /* Sombra */
    }

    .icon.light::before {
        content: "";
        z-index: -1;
        position: absolute;
        inset: 0;
        background-color: #0755AA;
        border-radius: 999rem;
    }

    html[lang="en"] .icon.light::before {
        transform: translateX(100%);
    }

    html[lang="en"]  .icon.dark,
    html:not([lang="en"])) .icon.light,
    button[aria-pressed="false"] .icon.light {
        color: #fff;
    }

    @media (prefers-reduced-motion: no-preference) {
        .icon,
        .icon.light::before {
            transition:
                transform var(--theme-transition),
                color var(--theme-transition);
        }
    }

    @media (forced-colors: active) {
        .icon.light::before {
            background-color: #0755AA;
        }
    }
</style>
