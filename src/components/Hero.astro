---
// #region Traducciones
import { getLangFromUrl, useTranslations } from "../locales/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// endregion

import { WritingText } from "./animate-ui/text/writing";
import PurchaseButton from "./Buttons/PurchaseButton.astro";
import PlannerButton from "./Buttons/PlannerButton.astro";
import BlurText from "./reactbits/BlurText";

const handleAnimationComplete = () => {
    console.log("All letters have animated!");
};

interface Props {
    title: string;
    tagline?: string;
}

const { tagline, title } = Astro.props;
---

<header class="o-heroSection">
    <div class="content">
        <div class="titleContainer">
            <h1 class="title">
                <BlurText
                    client:load
                    text={title as any}
                    delay={50}
                    animateBy="words"
                    direction="top"
                    onAnimationComplete={handleAnimationComplete}
                    className="title"
                }
                />
            </h1>
            <div class="subtitleContainer">
                <h2 class="-purchase">{t("iRacingPurchasePlanner")}</h2>
                <p>&</p>
                <h2 class="-planner">{t("iRacingCalendarPlanner")}</h2>
            </div>
        </div>

        {tagline && <p class="tagline">{tagline}</p>}

        <div class="heroActions">
            <PurchaseButton />
            <PlannerButton text="coomingSoon" buttonClass="-disabled" />
        </div>
    </div>
</header>

<style>
    .o-heroSection {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        column-gap: 64px;
        row-gap: 32px;
        padding: 3vw 16px 6vw 16px;
    }
    .o-heroSection * {
        font-family: "PT Sans", sans-serif;
    }

    .content,
    .img {
        flex: 1 1 350px;
    }

    .content {
        flex: 1.5 1 350px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        max-width: 850px;
        margin: auto;
    }
    .content * {
        text-align: center;
    }

    .titleContainer {
        display: flex;
        flex-direction: column-reverse;
        gap: 0.5rem;
    }
    .title {
        text-align: center;
        font-style: normal;
        font-weight: 700;
        font-size: 64px;
        line-height: 100%;
        /* or 48px */
        letter-spacing: -0.04em;
    }

    .subtitleContainer {
        display: flex;
        flex-direction: row;
        justify-content: center;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }
    .subtitleContainer .-purchase {
        --moduleColor: #ffd331;
    }
    .subtitleContainer .-planner {
        --moduleColor: #04dd81;
    }
    .subtitleContainer h2 {
        font-style: normal;
        font-weight: 600;
        font-size: 20px;
        line-height: 100%;
        /* identical to box height, or 24px */
        letter-spacing: -0.04em;
        color: var(--moduleColor);
    }

    .tagline {
        font-style: normal;
        font-weight: 400;
        font-size: 16px;
        background: linear-gradient(90deg, #ffffff 0%, #ffffff71 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-fill-color: transparent;
        max-width: 700px;
    }

    .heroActions {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 16px;
    }
</style>
