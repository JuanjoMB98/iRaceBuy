---
import "./Alert.css";

// #region Traducciones
import { getLangFromUrl, useTranslations } from "../../locales/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// endregion

interface Props {
    label?: string;
    text?: string;
    alertClass?: string;
}

const { label, text, alertClass } = Astro.props as Props;
---

<div class={"a-alert " + alertClass}>
    <div class="a-alertContent">
        {
            label && (
                <p class="a-alertLabel">
                    <strong>{t(label as any)}</strong>
                </p>
            )
        }
        <p class="a-alertText">
            {t(text as any)}
        </p>
    </div>
</div>
