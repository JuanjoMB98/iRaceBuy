---
import "./Alert.css";

// #region Traducciones
import { getLangFromUrl, useTranslations } from "../../locales/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// endregion

interface Props {
    label?: string;
    text?: string;
    alertClass?: string;
    expiresAt?: string;
}

const { label, text, alertClass, expiresAt } = Astro.props as Props;
---

<div class={"a-alert " + alertClass} data-expires-at={expiresAt}>
    <div class="a-alertContent">
        {
            label && (
                <p class="a-alertLabel">
                    <strong>{t(label as any)}</strong>
                </p>
            )
        }
        <p class="a-alertText">
            {t(text as any)}
        </p>
    </div>
</div>

<script>
    const alertEl = document.querySelector(".a-alert[data-expires-at]");

    if (alertEl) {
        const expiresAt = alertEl.getAttribute("data-expires-at");

        if (expiresAt && new Date(expiresAt).getTime() <= Date.now()) {
            alertEl.remove();
        }
    }
</script>
