---
// #region Traducciones
import { getLangFromUrl, useTranslations } from "../locales/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// endregion

import ProfileCard from "./reactbits/ProfileCard.jsx";
---

<aside>
    <div class="contactWrapper">
        <div class="content">
            <div class="text">
                <h2>{t("contact.title")}</h2>
                <p>{t("contact.content")}</p>
            </div>

            <div class="aboutMe">
                <p>{t("contact.aboutMe")}</p>
                <img src="/assets/modulesHome/iracingProfile.png" alt="" />
            </div>
        </div>

        <div class="actions">
            <ProfileCard
                client:load
                className="profileCard"
                name="Juanjo Mengual"
                handle="juanjomb98"
                status="Online"
                contactText={t("cta.contactMe")}
                avatarUrl="/assets/partners/me2.png"
                iconUrl="/assets/backgrounds/cheste.svg"
                showUserInfo={true}
                enableTilt={true}
                onContactClick="mailto:juniorsmastersbrand@gmail.com"
                behindGradient="transparent"
                
            />

            <a
                href="https://www.producthunt.com/products/iracebuy/reviews?utm_source=badge-product_review&utm_medium=badge&utm_source=badge-iracebuy"
                target="_blank"
            >
                <img
                    src="https://api.producthunt.com/widgets/embed-image/v1/product_review.svg?product_id=1076214&theme=dark"
                    alt="iRaceBuy - Plan your iRacing season & optimize your track purchases | Product Hunt"
                    style="width: 250px; height: 54px; border-radius: 23px; border: none;"
                    width="250"
                    height="54"
                />
            </a>
        </div>
    </div>
</aside>

<style>
    aside {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        border-top: 1px solid var(--gray-800);
        padding: 16px;
    }

    .contactWrapper {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex: 1;
        gap: 6vw;
        margin: auto;
    }
    .contactWrapper * {
        font-family: "PT-Sans", sans-serif;
    }

    .contactWrapper img {
        width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .content .text h2 {
        font-size: var(--text-2xl);
        font-weight: 600;
    }

    .content .text p {
        font-size: var(--text-base);
    }

    .actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
    }

    .content {
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-width: 800px;
    }
    .content .text {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .productHunt {
        background-color: rgb(255, 255, 255);
        border: none;
        border-radius: 23px;
    }



    .aboutMe {
        display: flex;
        flex-direction: column;
        gap: 16px;
        opacity: 0.5;
        font-size: 13px;
        text-align: justify;
    }
    .aboutMe img{
        max-width: 700px;
        margin: auto;
    }
    h2 {
        font-size: var(--text-xl);
        text-align: center;
        max-width: 15ch;
    }

    @media (min-width: 50em) {
        aside {
            padding: 7.5rem;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: space-between;
        }

        h2 {
            font-size: var(--text-3xl);
            text-align: left;
        }
    }
</style>
