---
import "../../styles/global.css";
import CookieConsentDialog from "../CookieConsentDialog.jsx";

interface Props {
    title?: string | undefined;
    description?: string | undefined;
    canonical?: string | undefined;
}

const {
    title = "iRaceBuy",
    description = "Select the series you plan to race and instantly discover the 8 most repeated tracks across them. Save money by buying only the content you’ll actually use.",
    canonical = "https://iracebuy.com/",
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{title}</title>

<meta name="author" content="Juniors Masters 2025" />
<meta name="description" property="og:description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical -->
<link rel="canonical" href={canonical} />

<!-- Favicon -->
<link
    rel="icon"
    type="image/png"
    href="https://iracebuy.com/assets/icons/favicon-96x96.png"
    sizes="96x96"
/>
<link
    rel="icon"
    type="image/svg+xml"
    href="https://iracebuy.com/assets/icons/favicon.svg"
/>
<link
    rel="shortcut icon"
    href="https://iracebuy.com/assets/icons/favicon.ico"
/>
<link
    rel="apple-touch-icon"
    sizes="180x180"
    href="https://iracebuy.com/assets/icons/apple-touch-icon.png"
/>
<meta name="apple-mobile-web-app-title" content="iRaceBuy" />
<link
    rel="manifest"
    href="https://iracebuy.com/assets/icons/site.webmanifest"
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="iRaceBuy" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content="iRaceBuy" />
<meta
    property="og:description"
    content="Select the series you plan to race and instantly discover the 8 most repeated tracks across them. Save money by buying only the content you’ll actually use | Race smarter, not pricier."
/>
<meta property="og:image" content="https://iracebuy.com/assets/ogImagen.png" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://iracebuy.com/" />
<meta property="twitter:title" content="iRaceBuy" />
<meta
    property="twitter:description"
    content="Select the series you plan to race and instantly discover the 8 most repeated tracks across them. Save money by buying only the content you’ll actually use | Race smarter, not pricier."
/>
<meta
    property="twitter:image"
    content="https://iracebuy.com/assets/ogImagen.png"
/>
<script defer is:inline src="https://code.jquery.com/jquery-3.7.0.min.js">
</script>
<script is:inline defer src="/scripts/main.js"></script>
<script
    async
    is:inline
    src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"
></script>
<script is:inline>
    window.addEventListener("DOMContentLoaded", function () {
        if (window.kofiWidgetOverlay) {
            window.kofiWidgetOverlay.draw("juanjomb98", {
                type: "floating-chat",
                "floating-chat.donateButton.text": "Support me",
                "floating-chat.donateButton.background-color": "#ff5f5f",
                "floating-chat.donateButton.text-color": "#fff",
            });
        }
        // Espera un poco a que el iframe se genere
        setTimeout(function () {
            var kofiIframe = document.querySelector(
                "iframe[id^='kofi-wo-container']"
            );
            if (kofiIframe) {
                kofiIframe.setAttribute("title", "Ko-fi Support Chat Widget");
            }
        }, 1000); // 1 segundo suele ser suficiente, ajusta si es necesario
    });
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    rel="stylesheet"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
/>

<CookieConsentDialog client:only="react" />
