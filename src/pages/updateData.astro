---
// #region Traducciones
import { downloadData } from "../lib/iracingApi";
import { test } from '../functions/prepareDataSeason';
// endregion

import NoIndexLayout from "../layouts/NoIndexLayout.astro";

await Promise.all([
    downloadData("series/seasons", "currentSeason"),
    downloadData("track/get", "tracks"),
    downloadData("track/assets", "tracksAssets"),
    downloadData("series/assets", "seriesLogos"),
]);

test();
