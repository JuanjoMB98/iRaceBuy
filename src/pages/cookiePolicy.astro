---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cookie Policy" description="Cookie Policy for iRaceBuy" canonical ="https://iracebuy.com/cookiePolicy/">
    <div class="wrap">
        <h2>Cookie Policy</h2>
        <p>
            This website uses technical cookies necessary for its operation and,
            with your consent, analytics cookies (e.g., Google Analytics) to
            improve the user experience. Analytics cookies are only set after
            you provide explicit consent. You can accept, reject, or configure
            cookies at any time using the cookie settings panel [2][4][5].
        </p>
        <p>
            If Google AdSense is enabled, advertising cookies may be used to
            display personalized ads. These cookies track your browsing activity
            across websites and are only set with your explicit consent. You can
            manage your preferences or withdraw consent at any time [6][8].
        </p>
        <p>
            For more information about the cookies we use, including their
            purpose, duration, and providers, please refer to our full Cookie
            Policy. You can also find more details about how Google uses cookies <a
                href="https://policies.google.com/technologies/cookies"
            >
                here
            </a>.
        </p>
    </div>
</BaseLayout>

<style>
    .wrap {
        max-width: 800px;
        margin: auto;
        margin-bottom: 124px;
    }
    .wrap * {
        text-align: center;
    }
    h2 {
        opacity: 0.8;
    }
    .wrap li {
        text-align: start;
    }
</style>
