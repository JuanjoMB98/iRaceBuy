---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy" description="Privacy Policy for iRaceBuy" canonical ="https://iracebuy.com/privacyPolicy/">
    <div class="wrap">
        <h2>Privacy Policy</h2>
        <p>
            We collect personal data (such as name and email) only when you
            contact us through our forms.<br />
            The purpose of data collection is to respond to your inquiries.<br
            />
            The legal basis for processing is your consent.<br />
            We do not share your data with third parties except for technical service
            providers (hosting, email), all within the EU.<br />
            You can exercise your rights of access, rectification, erasure, and others
            by contacting [Your Email].<br />
            We do not transfer your data outside the EU.<br />
            Data is kept only as long as necessary to fulfill your request.
        </p>
        <p>
            This website uses Google Analytics to analyze website traffic.
            Google Analytics may collect information such as your IP address,
            device information, and browsing behavior. Data collected by Google
            Analytics may be transferred to and processed in the United States.
            We have entered into a Data Processing Agreement with Google as
            required by GDPR. You can find more information about how Google
            uses your data <a
                href="https://policies.google.com/technologies/partner-sites"
            >
                here
            </a> [1][2][4][5].
        </p>
        <p>
            If Google AdSense is enabled, third-party vendors, including Google,
            use cookies to serve ads based on your prior visits to this and
            other websites. Google's use of advertising cookies enables it and
            its partners to serve ads to you based on your visit to this site
            and/or other sites on the Internet. You may opt out of personalized
            advertising by visiting <a href="https://adssettings.google.com/">
                Google Ad Settings
            </a> or <a href="https://www.aboutads.info/">aboutads.info</a> [6][7].
        </p>
    </div>
</BaseLayout>

<style>
    .wrap {
        max-width: 800px;
        margin: auto;
        margin-bottom: 124px;
    }
    .wrap * {
        text-align: center;
    }
    h2 {
        opacity: 0.8;
    }
    .wrap li {
        text-align: start;
    }
</style>
