---
// Component Imports
import MainHead from "../components/layout/Head.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import ContactCTA from "../components/ContactCTA.astro";
import { getLangFromUrl } from '../locales/utils';
import Alert from "../components/Alert/Alert.astro";

const lang = getLangFromUrl(Astro.url);

interface Props {
    title?: string | undefined;
    description?: string | undefined;
    canonical?: string | undefined;
    lang?: string | undefined;
}

const { title, description, canonical } = Astro.props;

---

<html lang={lang} class="theme-dark">
    <head>
        <MainHead
            title={title}
            description={description}
            canonical={canonical}
        />
    </head>
    <body>
        <Header lang={lang} />

        <div class="wrap">
            <main>
                <!-- <Alert text="alert.actualizacionPendiente"  alertClass="-red" label="alert.calendarioPendiente"/> -->
                <!-- <Alert text="alert.actualizacionCompletada"  alertClass="-green" label="alert.calendarioActualizado"/> -->

                <slot/>
            </main>
        </div>

        <ContactCTA />

    </body>

    <Footer />

</html>
